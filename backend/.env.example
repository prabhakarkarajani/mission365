# All variables below are required unless marked optional/defaulted.
# Validated at startup by src/config/env.ts - the server refuses to boot
# (throws before connecting to Mongo or opening a port) if this file's
# constraints aren't met. Production-only constraints are called out
# explicitly; everything else applies in every environment.

# One of: development | test | production. Defaults to "development" if
# unset. Deployments must set this explicitly to "production" - several
# other checks below only activate when it's set to that value.
NODE_ENV=development

# Optional, defaults to 4000.
PORT=4000

# Must start with mongodb:// or mongodb+srv://.
MONGODB_URI=mongodb://127.0.0.1:27017/mission365

# Required, minimum 16 characters. JWT_ACCESS_SECRET and
# JWT_REFRESH_SECRET must not be identical (checked in every
# environment - a leaked access token must not also be a valid refresh
# token). In production, values containing common placeholder markers
# ("replace-with", "change-me", "your-secret", "example") are rejected
# outright, so copying this file's example values into a real deployment
# fails fast instead of silently shipping a known secret. Generate real
# values with e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Optional, default "15m" / "30d". Any string jsonwebtoken's `expiresIn`
# accepts (e.g. "15m", "1h", "30d").
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# The allowed frontend origin(s) for CORS. Defaults to "*" (any origin) -
# fine for local development, but in production ("NODE_ENV=production")
# this must be set to the real deployed frontend origin; "*" is rejected
# at startup rather than silently allowing every origin to call the
# authenticated API with credentials.
CORS_ORIGIN=*

# This API is fully stateless / header-based: access and refresh tokens
# are returned in the JSON response body and sent back via the
# `Authorization: Bearer <token>` header (see src/middleware/auth.ts).
# No cookies, no cookie-parser, no session middleware exist anywhere in
# this backend, so there is no cookie security configuration (SameSite,
# Secure, HttpOnly, etc.) to set here. If cookie-based session/refresh
# storage is ever introduced, this file and src/config/env.ts must both
# be revisited at that time.

# One of: mock | openai. Defaults to "mock" - the server works out of the
# box with no AI vendor configured, using a deterministic canned-response
# provider (see src/ai/providers/mock). This is also what CI always uses
# (see src/test/setupEnv.ts) - never a real vendor. Whichever provider is
# selected here, its corresponding *_API_KEY below becomes required
# (checked in every environment, not just production - a missing key for
# the active provider would fail on the very first Coach request otherwise).
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai. The mobile/web app never holds
# this key or calls OpenAI directly - it only talks to this backend, which
# is the sole place any AI vendor key ever lives.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Per-request timeout for any AI vendor call, in milliseconds.
AI_REQUEST_TIMEOUT_MS=20000
